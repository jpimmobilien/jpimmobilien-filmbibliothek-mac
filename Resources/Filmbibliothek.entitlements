<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App-Sandbox: die App sieht nur, was der Nutzer ausdrücklich freigibt -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Vom Nutzer gewählte Ordner/Laufwerke (Dialog, Ziehen, Öffnen mit) – NUR LESEN -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Dauerhafte, sicherheitsgeschützte Lesezeichen für diese Ordner (Zugriff nach Neustart) -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Bewusst NICHT enthalten: Netzwerk, Kamera, Mikrofon, Festplattenvollzugriff, Schreibzugriff -->
</dict>
</plist>
